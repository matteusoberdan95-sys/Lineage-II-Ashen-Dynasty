# Ashen Dynasty local environment template.
# Copy to .env only when a future script requires it. Never commit .env.

L2AD_ENVIRONMENT=Local

# Pinned upstream source.
L2AD_SERVER_SOURCE_DIR=server/source/l2jmobius-upstream/L2J_Mobius_CT_0_Interlude
L2AD_SERVER_RUNTIME_DIR=server/runtime

# Local-only network endpoints.
L2AD_LOGIN_HOST=127.0.0.1
L2AD_LOGIN_PORT=2106
L2AD_GAME_HOST=127.0.0.1
L2AD_GAME_PORT=7777

# Database values reserved for future project-owned runtime generation.
# Local scripts currently obtain the password from a DPAPI-protected credential.
L2AD_DB_HOST=127.0.0.1
L2AD_DB_PORT=3306
L2AD_DB_NAME=l2jmobiusinterlude
L2AD_DB_USER=l2server
# Intentionally blank. Never put a real password in this tracked template.
L2AD_DB_PASSWORD=

# Tool paths are optional when already available through PATH.
JAVA_HOME=
ANT_HOME=
