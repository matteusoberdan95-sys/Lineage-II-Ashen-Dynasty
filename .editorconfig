root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,xml,xsd}]
indent_style = tab
indent_size = 4

[*.{cs,csproj,props,targets,json,yml,yaml,ps1,sql}]
indent_style = space
indent_size = 4

[*.{md,html,htm}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
